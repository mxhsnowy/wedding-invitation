{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/vu-quy", "destination": "/index.html" },
    { "source": "/nha-gai", "destination": "/index.html" },
    { "source": "/bride", "destination": "/index.html" },
    { "source": "/bua-com-nha-gai", "destination": "/index.html" },
    { "source": "/an-hoi", "destination": "/index.html" },
    { "source": "/nha-trai", "destination": "/index.html" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    }
  ]
}
